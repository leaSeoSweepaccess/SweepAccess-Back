model Order {
  id        String      @id
  tenantId  String
  amount    Int
  currency  String
  status    OrderStatus
  // 
  createdAt DateTime?   @default(now())
  createdBy String?
  updatedAt DateTime?   @updatedAt
  updatedBy String?
  //
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}
