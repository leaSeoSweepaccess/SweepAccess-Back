model Tenant {
  id                            String                          @id
  name                          String
  /// @zod.email()
  email                         String                          @unique
  /// @zod.url()
  avatar                        String?
  description                   String?
  /// @zod.url()
  url                           String?
  paymentCycle                  PaymentCycle?
  //
  ApplicationCollaboratorTenant ApplicationCollaboratorTenant[]
  ApplicationTenant             ApplicationTenant[]
  CollaboratorTenant            CollaboratorTenant[]
  orders                        Order[]
  users                         User[]
  seats                         Seat[]
  //
  createdAt                     DateTime?                       @default(now())
  createdBy                     String?
  updatedAt                     DateTime?                       @updatedAt
  updatedBy                     String?
  deletedAt                     DateTime?
  deletedBy                     String?
  isDeleted                     Boolean                         @default(false)
}

enum PaymentCycle {
  MONTHLY
  YEARLY
}
